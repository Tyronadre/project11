# Copy to .env on the Pi. Never commit .env or paste its contents into logs.
# Hostname only; no https:// and no path.
SITE_DOMAIN=friends.example.com
ACME_EMAIL=you@example.com

# Generate before creating a NEW database. For migration use its original credentials.
DB_USERNAME=project11
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

# A sender at a domain you control; use a working mailbox for replies/bounces.
MAIL_FROM=notifications@example.com
MAIL_DOMAIN=example.com
# Its A record and your public IPv4 PTR record must point to each other.
MAIL_HOSTNAME=mail.example.com
